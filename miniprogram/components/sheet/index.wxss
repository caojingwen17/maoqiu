/* sheet —— §7.7 底部弹层 */
.sheet-root { position: fixed; inset: 0; z-index: 900; }

.sheet-mask {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.3);
  opacity: 0;
  transition: opacity 200ms var(--fade);
}

.sheet-mask.show { opacity: 1; }

.sheet-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 50%;
  display: flex;
  flex-direction: column;
  background: var(--bg-card);
  border-radius: var(--r-l) var(--r-l) 0 0;
  box-shadow: var(--shadow-elevated);
  transition: transform 500ms var(--spring);
  overflow: hidden;
}

.sheet-panel.full { height: 92%; }
.sheet-panel.dragging { transition: none; }

/* 头部：抓握条 + 毛玻璃（§5.1 应用位置 3） */
.sheet-header {
  position: relative;
  flex-shrink: 0;
  padding: 16rpx 0 20rpx;
  background: rgba(250, 246, 239, 0.82);
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  touch-action: none;
}

@media (prefers-color-scheme: dark) {
  .sheet-header { background: rgba(14, 14, 13, 0.78); }
}

/* §7.7：48×6rpx 抓握条，Text-Tertiary 色 */
.sheet-grabber {
  width: 48rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: var(--text-tertiary);
  margin: 0 auto;
}

.sheet-title {
  margin-top: 12rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.35;
  color: var(--text-primary);
}

.sheet-body {
  flex: 1;
  padding: 0 32rpx;
  box-sizing: border-box;
  padding-bottom: calc(constant(safe-area-inset-bottom) + 32rpx);
  padding-bottom: calc(env(safe-area-inset-bottom) + 32rpx);
}
