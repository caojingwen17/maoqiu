<view class="fi {{focused ? 'focus' : ''}} {{error ? 'error' : ''}} {{value || focused ? 'floated' : ''}} {{type === 'textarea' ? 'fi-textarea' : ''}}">

  <view class="fi-box">
    <view class="fi-label">{{label}}</view>

    <textarea wx:if="{{type === 'textarea'}}" class="fi-control fi-area"
      value="{{value}}" auto-height maxlength="-1"
      bindinput="onInput" bindfocus="onFocus" bindblur="onBlur" bindconfirm="onConfirm" />
    <input wx:else class="fi-control" type="{{type === 'digit' ? 'digit' : 'text'}}"
      value="{{value}}"
      bindinput="onInput" bindfocus="onFocus" bindblur="onBlur" bindconfirm="onConfirm" />

    <!-- 清除按钮：聚焦且有内容时显示 -->
    <view wx:if="{{focused && value}}" class="fi-clear" catchtap="onClear"
      style="-webkit-mask-image: url('{{closeUri}}'); mask-image: url('{{closeUri}}');"></view>

    <!-- 底部 2rpx 横条：聚焦从中心展开；错误态 Danger + 脉冲一次 -->
    <view class="fi-bar"></view>
  </view>

  <view wx:if="{{error}}" class="fi-error-text">{{error}}</view>

</view>
