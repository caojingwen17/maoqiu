<view wx:if="{{rendered}}" class="nk-root">

  <view class="nk-mask {{active ? 'show' : ''}}" bindtap="onMaskTap"></view>

  <view class="nk-panel {{active ? 'show' : ''}}">

    <!-- 顶部实时大数：Title-1 + 单位 Caption 置灰 -->
    <view class="nk-display">
      <text class="nk-value">{{text}}</text>
      <text wx:if="{{unit}}" class="nk-unit">{{unit}}</text>
      <view class="nk-done" hover-class="nk-done-hover" bindtap="onConfirm">完成</view>
    </view>

    <!-- 键盘区 -->
    <view class="nk-grid">
      <block wx:for="{{keys}}" wx:key="index">
        <view wx:if="{{item === 'del'}}" class="nk-key" hover-class="nk-key-hover"
          data-key="del" bindtap="onKey">
          <view class="nk-del-icon"
            style="-webkit-mask-image: url('{{delUri}}'); mask-image: url('{{delUri}}');"></view>
        </view>
        <view wx:else class="nk-key" hover-class="nk-key-hover"
          data-key="{{item}}" bindtap="onKey">{{item}}</view>
      </block>
    </view>

    <view class="nk-safe"></view>
  </view>
</view>
