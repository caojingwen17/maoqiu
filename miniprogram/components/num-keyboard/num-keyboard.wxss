.numpad {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--bg);
  border-radius: 44rpx 44rpx 0 0;
  box-shadow: 0 -18rpx 88rpx rgba(0, 0, 0, 0.12);
  padding: 22rpx 22rpx 44rpx;
  transform: translateY(105%);
  transition: transform 0.5s var(--spring);
  z-index: 20;
}
.numpad.show {
  transform: translateY(0);
}
.np-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
}
.np-key {
  height: 118rpx;
  border-radius: 26rpx;
  background: var(--card);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 600;
  color: var(--text);
  font-variant-numeric: tabular-nums;
}
.np-key.jin {
  font-size: 33rpx;
}
.np-hover {
  background: var(--fill-deep);
}
.np-done {
  margin-top: 18rpx;
  height: 100rpx;
  border-radius: 26rpx;
  background: var(--primary);
  color: #FAF6EF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 33rpx;
  font-weight: 600;
}