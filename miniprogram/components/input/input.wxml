<view class="frow input-row">
  <text class="k" wx:if="{{label}}">{{label}}</text>
  <view class="ival">
    <input
      class="{{bold ? 'b' : ''}}"
      type="{{type}}"
      value="{{value}}"
      placeholder="{{placeholder}}"
      placeholder-class="{{placeholderClass}}"
      disabled="{{disabled}}"
      maxlength="{{maxlength}}"
      focus="{{focused}}"
      bindinput="onInput"
      bindfocus="onFocus"
      bindblur="onBlur"
    />
    <text class="unit" wx:if="{{unit}}">{{unit}}</text>
  </view>
</view>