<view class="pp">

  <view wx:for="{{items}}" wx:key="key" class="pp-slot"
    data-key="{{item.key}}"
    catchtap="onSlotTap"
    bindlongpress="onLongPress">
    <image class="pp-img" src="{{item.src}}" mode="aspectFill" />

    <!-- 上传中：进度遮罩 -->
    <view wx:if="{{item.status === 'uploading'}}" class="pp-mask">
      <view class="pp-progress">{{item.progress}}%</view>
    </view>

    <!-- 失败：重传角标 -->
    <view wx:if="{{item.status === 'failed'}}" class="pp-mask pp-failed">
      <view class="pp-retry"
        style="-webkit-mask-image: url('{{retryUri}}'); mask-image: url('{{retryUri}}');"></view>
      <view class="pp-failed-text">重传</view>
    </view>
  </view>

  <!-- 添加槽位：实线 Hairline 边框 + 中央相机线图标（§8.3） -->
  <view wx:if="{{items.length < max}}" class="pp-slot pp-add" bindtap="onAdd"
    hover-class="pp-add-hover">
    <view class="pp-camera"
      style="-webkit-mask-image: url('{{cameraUri}}'); mask-image: url('{{cameraUri}}');"></view>
  </view>

</view>
