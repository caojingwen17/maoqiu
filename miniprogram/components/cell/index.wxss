/* cell —— §7.6 inset-grouped 列表行 */
.cell {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
  background: var(--bg-card);
}

.cell-double { min-height: 128rpx; }

/* 按下整行 BG-Fill-Deep，无缩放（§5.3） */
.cell-hover { background: var(--bg-fill-deep); }

/* 组内 0.5px hairline，左缩进从文字起始位开始（§5.2） */
.cell-hairline {
  position: absolute;
  top: 0;
  left: 32rpx;
  right: 0;
  height: 1px;
  background: var(--hairline);
  transform: scaleY(0.5);
  transform-origin: top;
}

.cell-hairline-icon { left: 104rpx; } /* 32 边距 + 48 图标 + 24 间距 */

.cell-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
  background: var(--text-secondary);
  -webkit-mask-size: contain;
  mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
}

.cell-body { flex: 1; min-width: 0; padding: 20rpx 0; }

.cell-title {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.35;
  color: var(--text-primary);
}

.cell-desc {
  margin-top: 4rpx;
  font-size: 26rpx;
  line-height: 1.35;
  color: var(--text-secondary);
}

.cell-value {
  font-size: 28rpx;
  line-height: 1.35;
  color: var(--text-secondary);
  margin-left: 24rpx;
  flex-shrink: 0;
}

/* iOS 式细箭头 ›（SVG mask，chevron-right） */
.cell-arrow {
  width: 28rpx;
  height: 28rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
  background: var(--text-tertiary);
  -webkit-mask-size: contain;
  mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
}

/* 开关：开启 Primary，轨道圆角 full，滑块 300ms Snap 轻微 overshoot（§7.6） */
.cell-switch {
  width: 96rpx;
  height: 56rpx;
  border-radius: 999rpx;
  background: var(--bg-fill-deep);
  margin-left: 24rpx;
  flex-shrink: 0;
  position: relative;
  transition: background 200ms var(--fade);
}

.cell-switch.on { background: var(--primary); }

.cell-switch-knob {
  position: absolute;
  top: 5rpx;
  left: 5rpx;
  width: 46rpx;
  height: 46rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
  transition: transform 300ms cubic-bezier(0.34, 1.25, 0.64, 1);
}

.cell-switch.on .cell-switch-knob { transform: translateX(40rpx); }
