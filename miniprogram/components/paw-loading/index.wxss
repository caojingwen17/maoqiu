/* paw-loading —— §7.1 猫爪描边 / iOS 12 辐条 spinner */
.paw-loading {
  display: inline-block;
}

.paw-canvas {
  width: 100%;
  height: 100%;
}

/* spinner：12 根渐隐辐条，steps(12) 离散旋转（iOS spinner 惯例，循环动画不受 §6 曲线约束） */
.paw-spinner {
  position: relative;
  width: 100%;
  height: 100%;
  animation: paw-spin 1s steps(12) infinite;
}

.spoke {
  position: absolute;
  left: 50%;
  top: 0;
  width: 2rpx;
  height: 32%;
  margin-left: -1rpx;
  background: #FFFFFF;
  border-radius: 2rpx;
  transform-origin: 1rpx 8rpx;
}

@keyframes paw-spin {
  to { transform: rotate(360deg); }
}
