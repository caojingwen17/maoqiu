.paw-loader {
  position: fixed;
  inset: 0;
  background: var(--bg);
  z-index: 60;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 35rpx;
  transition: opacity 0.4s;
}
.pw {
  width: 123rpx;
  height: 123rpx;
  position: relative;
}
.pw-s {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  animation: trace 1.3s cubic-bezier(0.4, 0, 0.2, 1) infinite;
}
.pw-s:nth-child(2) { animation-delay: 0.12s; }
.pw-s:nth-child(3) { animation-delay: 0.2s; }
.pw-s:nth-child(4) { animation-delay: 0.28s; }
.pw-s:nth-child(5) { animation-delay: 0.36s; }
.pk {
  font-size: 24rpx;
  color: var(--t3);
}
@keyframes trace {
  0% { opacity: 0; }
  55% { opacity: 1; }
  80% { opacity: 1; }
  100% { opacity: 0; }
}