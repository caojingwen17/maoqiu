/* swipe-cell —— §7.6 滑动操作（右滑露出左侧操作块） */
.swipe-cell {
  position: relative;
  overflow: hidden;
}

.swipe-actions {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  display: flex;
}

.swipe-action {
  width: 112rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.theme-success { background: var(--success); color: #FFFFFF; }
.theme-danger { background: var(--danger); color: #FFFFFF; }
.theme-neutral { background: var(--bg-fill-deep); color: var(--text-primary); }

.swipe-action-icon {
  width: 44rpx;
  height: 44rpx;
  background: currentColor;
  -webkit-mask-size: contain;
  mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
}

.swipe-action-text {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.35;
}

.swipe-content {
  position: relative;
  background: var(--bg-card);
  transition: transform 350ms var(--snap);
}

.swipe-content.dragging { transition: none; }
