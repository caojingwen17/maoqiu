<view class="swipe-cell" bindtouchstart="onTouchStart" bindtouchmove="onTouchMove"
  bindtouchend="onTouchEnd" bindtouchcancel="onTouchEnd">

  <!-- 左侧操作块：图标 + 竖排文字 -->
  <view class="swipe-actions" style="width: {{actionsWidthPx}}px;">
    <view wx:for="{{_actions}}" wx:key="key" class="swipe-action theme-{{item.theme}}"
      data-index="{{index}}" catchtap="onActionTap">
      <view wx:if="{{item.iconUri}}" class="swipe-action-icon"
        style="-webkit-mask-image: url('{{item.iconUri}}'); mask-image: url('{{item.iconUri}}');"></view>
      <view class="swipe-action-text">{{item.text}}</view>
    </view>
  </view>

  <!-- 内容层 -->
  <view class="swipe-content {{dragging ? 'dragging' : ''}}"
    style="transform: translateX({{offsetX}}px);">
    <slot></slot>
  </view>

</view>
