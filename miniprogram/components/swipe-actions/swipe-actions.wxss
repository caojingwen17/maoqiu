.sa {
  position: relative;
  overflow: hidden;
}
/* 行内容层：保持不动，按钮层从右缘滑入后覆盖其右侧区域 */
.sa-body {
  position: relative;
  z-index: 1;
  background: var(--card);
}
.sa-actions {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
  display: flex;
  transition: transform 0.25s var(--spring), opacity 0.25s var(--spring);
}
/* 拖动过程中禁用过渡，否则每帧 setData 都被 0.25s 动画拖住，表现为闪烁/抖动 */
.sa-actions.moving {
  transition: none;
}
.sa-act {
  min-width: 130rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  padding: 0 26rpx;
}
