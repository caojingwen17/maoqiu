<view class="sk">

  <!-- card：单张信息卡 -->
  <view wx:if="{{type === 'card'}}" class="sk-card">
    <view class="sk-row">
      <view class="sk-block sk-avatar"></view>
      <view class="sk-col">
        <view class="sk-block sk-line" style="width: 40%;"></view>
        <view class="sk-block sk-line sk-line-sm" style="width: 62%;"></view>
      </view>
    </view>
    <view class="sk-block sk-line sk-gap" style="width: 82%;"></view>
    <view class="sk-shine"></view>
  </view>

  <!-- list：3 行列表 -->
  <view wx:elif="{{type === 'list'}}" class="sk-card">
    <view wx:for="{{rows}}" wx:key="index" class="sk-row sk-list-row {{index < rows.length - 1 ? 'sk-hairline' : ''}}">
      <view class="sk-block sk-icon"></view>
      <view class="sk-col">
        <view class="sk-block sk-line" style="width: 46%;"></view>
        <view class="sk-block sk-line sk-line-sm" style="width: 68%;"></view>
      </view>
    </view>
    <view class="sk-shine"></view>
  </view>

  <!-- home：统计横幅 + 双列卡片网格 -->
  <view wx:else class="sk-home">
    <view class="sk-card sk-banner">
      <view class="sk-block sk-line" style="width: 30%;"></view>
      <view class="sk-row sk-banner-row">
        <view class="sk-block sk-line sk-banner-cell"></view>
        <view class="sk-block sk-line sk-banner-cell"></view>
        <view class="sk-block sk-line sk-banner-cell"></view>
      </view>
      <view class="sk-shine"></view>
    </view>
    <view class="sk-grid">
      <view wx:for="{{cards}}" wx:key="index" class="sk-card sk-grid-card">
        <view class="sk-row">
          <view class="sk-block sk-avatar"></view>
          <view class="sk-col">
            <view class="sk-block sk-line" style="width: 52%;"></view>
            <view class="sk-block sk-line sk-line-sm" style="width: 76%;"></view>
          </view>
        </view>
        <view class="sk-block sk-line sk-gap" style="width: 88%;"></view>
        <view class="sk-shine"></view>
      </view>
    </view>
  </view>

</view>
