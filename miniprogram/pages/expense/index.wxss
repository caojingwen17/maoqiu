/* pages/expense/index.wxss —— 花销记账页（对照效果图「花销记账」） */
.page {
  padding: 0 32rpx 160rpx;
}

.large-title {
  padding: 12rpx 0 24rpx;
  font-size: 68rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  color: var(--text-primary);
}

.card {
  margin-bottom: 24rpx;
  padding: 28rpx 32rpx;
  background: var(--bg-card);
  border-radius: var(--r-m);
}

.list-card {
  padding: 20rpx 32rpx 8rpx;
}

/* —— 月度总览 —— */
.ov-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.ov-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.ov-total {
  margin-top: 4rpx;
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  color: var(--text-primary);
}

/* 超预算：整数字变 Pop-Deep */
.ov-total.over {
  color: var(--pop-deep);
}

.ov-dec {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-tertiary);
}

.ov-over {
  margin-top: 6rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--pop-deep);
}

.pet-pill {
  flex: none;
  margin-top: 4rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: var(--bg-fill);
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-secondary);
  white-space: nowrap;
}

/* 按压只变色不缩放（§5.3） */
.pet-pill:active {
  background: var(--bg-fill-deep);
}

/* 预算进度条（.bar：已用比例，Pop 焦糖，cap 100%） */
.budget-bar {
  margin-top: 28rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: var(--bg-fill);
  overflow: hidden;
}

.budget-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--pop);
  transition: width 350ms var(--snap);
}

.budget-row {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.budget-used {
  font-weight: 600;
  color: var(--pop-deep);
}

/* —— 账单列表 —— */
.group-title {
  padding: 8rpx 0 4rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

.row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 112rpx;
  padding: 12rpx 0;
}

.row-grow {
  flex: 1;
  min-width: 0;
}

.row-t {
  font-size: 28rpx;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-s {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.row-amt {
  flex: none;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.empty-card {
  padding: 8rpx 32rpx 28rpx;
}

.more-tip {
  padding: 16rpx 0 32rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-tertiary);
}
