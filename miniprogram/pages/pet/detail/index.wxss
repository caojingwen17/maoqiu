/* pages/pet/detail/index.wxss
 * 视觉基准：doc/index.html「宠物详情 · 时间线」「健康档案」
 */
page {
  /* ♀ 粉色无全局 token，页面局部定义后仍走 var() 引用 */
  --pink: #B87B8E;
  --success-tint: rgba(52, 160, 92, 0.1);
}

/* ---------- 通用卡片 / 胶囊 / 图标块 ---------- */
.card {
  background: var(--bg-card);
  border-radius: var(--r-m);
  padding: 28rpx 32rpx;
  margin: 0 32rpx 24rpx;
}

.pill {
  font-size: 20rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  white-space: nowrap;
  flex: none;
}
.pill.warn { color: var(--pop-deep); background: var(--pop-tint); }
.pill.danger { color: var(--danger); background: var(--pop-tint); }
.pill.ok { color: var(--success); background: var(--success-tint); }
.pill.grey { color: var(--text-secondary); background: var(--bg-fill); }

.ticon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.chev {
  width: 28rpx;
  height: 28rpx;
  background: var(--text-tertiary);
  -webkit-mask-size: contain;
  mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
  flex: none;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex: none;
}

.hl {
  height: 1px;
  background: var(--hairline);
  transform: scaleY(0.5);
  margin: 0 -32rpx 0 100rpx; /* 左缩进对齐文字起始位 */
}

.row-hover { background: var(--bg-fill-deep); border-radius: var(--r-s); }
.txt-hover { opacity: 0.6; }
.chip-hover { background: var(--bg-fill-deep); }

/* ---------- 档案头卡 ---------- */
.hd {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 16rpx;
}
.hd-info { flex: 1; min-width: 0; }
.hd-name {
  font-size: 44rpx; /* Title-2 */
  font-weight: 600;
  color: var(--text-primary);
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.hd-gender { font-size: 30rpx; }
.hd-gender.male { color: var(--info); }
.hd-gender.female { color: var(--pink); }
.hd-line {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
}
.hd-sub {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-top: 4rpx;
}
.hd-side {
  align-self: stretch;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: space-between;
  flex: none;
}
.hd-edit {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--pop-deep);
  padding: 8rpx 0 8rpx 24rpx;
}

/* ---------- 分段选择器吸顶 ---------- */
.seg-stick {
  position: sticky;
  top: 0;
  z-index: 10;
  background: var(--bg-page);
  padding: 8rpx 32rpx 16rpx;
  display: flex;
}
.seg-stick segmented { flex: 1; }

/* ---------- 类型筛选 Chip ---------- */
.chips {
  white-space: nowrap;
  padding: 0 32rpx 16rpx;
  box-sizing: border-box;
}
.chip {
  display: inline-block;
  font-size: 26rpx;
  color: var(--text-secondary);
  background: var(--bg-fill);
  border-radius: var(--r-s);
  padding: 10rpx 28rpx;
  margin-right: 16rpx;
}
.chip.on {
  background: var(--primary-tint);
  color: var(--primary);
  font-weight: 600;
}

/* ---------- 时间线（.tl 圆点竖线贯穿） ---------- */
.tl-card { padding: 20rpx 32rpx; }
.tl {
  position: relative;
  padding-left: 28rpx;
}
.tl::before {
  content: '';
  position: absolute;
  left: 8rpx;
  top: 16rpx;
  bottom: 16rpx;
  width: 3rpx;
  background: var(--hairline);
}
.tl-date {
  position: relative;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-secondary);
  padding: 12rpx 0 4rpx 24rpx;
}
.tl-date::before {
  content: '';
  position: absolute;
  left: -26rpx;
  top: 22rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--primary);
  box-shadow: 0 0 0 6rpx var(--bg-card);
}
.tl-item {
  position: relative;
  padding: 16rpx 0 16rpx 24rpx;
  overflow: hidden;
  max-height: 1200rpx;
  transition: max-height var(--t-snap) var(--snap), opacity var(--t-fade) var(--fade),
    padding var(--t-snap) var(--snap);
}
.tl-item::before {
  content: '';
  position: absolute;
  left: -26rpx;
  top: 32rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--c, #C08A4E);
  box-shadow: 0 0 0 6rpx var(--bg-card);
}
.tl-item.collapsing {
  max-height: 0;
  opacity: 0;
  padding-top: 0;
  padding-bottom: 0;
}
.tl-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 4rpx;
  margin: -4rpx;
}
.tl-main { flex: 1; min-width: 0; }
.tl-title {
  font-size: 28rpx;
  color: var(--text-primary);
}
.tl-sub {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}
.tl-thumbs {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
  padding-left: 88rpx;
}
.tl-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--r-s);
  background: var(--bg-fill);
}

/* 展开详情卡片 */
.tl-detail {
  margin-top: 16rpx;
  margin-left: 88rpx;
  background: var(--bg-fill);
  border-radius: var(--r-s);
  padding: 20rpx 24rpx;
}
.tl-dline {
  display: flex;
  gap: 24rpx;
  padding: 6rpx 0;
}
.tl-dk {
  width: 140rpx;
  flex: none;
  font-size: 24rpx;
  color: var(--text-secondary);
}
.tl-dv {
  flex: 1;
  font-size: 24rpx;
  color: var(--text-primary);
}
.tl-note {
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--text-primary);
  margin-top: 12rpx;
}
.tl-photos {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}
.tl-photo {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--r-s);
  background: var(--bg-fill);
}

.list-foot {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-tertiary);
  padding: 8rpx 0 48rpx;
}

/* ---------- 健康 Tab ---------- */
.card-h {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.card-title { font-size: 28rpx; font-weight: 600; color: var(--text-primary); }
.card-more { font-size: 22rpx; color: var(--text-secondary); }
.chart { width: 100%; height: 200rpx; display: block; }
.chart-months {
  display: flex;
  justify-content: space-between;
  font-size: 20rpx;
  color: var(--text-tertiary);
  margin-top: 8rpx;
}
.chart-empty {
  font-size: 24rpx;
  color: var(--text-tertiary);
  text-align: center;
  padding: 48rpx 0 40rpx;
}

.secs { padding-top: 12rpx; padding-bottom: 12rpx; }
.sec-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 112rpx;
  padding: 8rpx 4rpx;
  margin: 0 -4rpx;
}
.sec-main { flex: 1; min-width: 0; }
.sec-title { font-size: 28rpx; color: var(--text-primary); }
.sec-sub { font-size: 22rpx; color: var(--text-secondary); margin-top: 4rpx; }
.sec-list {
  margin: 0 0 12rpx 88rpx;
  background: var(--bg-fill);
  border-radius: var(--r-s);
  padding: 8rpx 24rpx;
}
.sec-rec {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 0;
}
.sec-rec-t {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.sec-rec-empty { color: var(--text-tertiary); }
.sec-rec-d { font-size: 22rpx; color: var(--text-tertiary); flex: none; }

/* ---------- 花销 Tab ---------- */
.exp-label { font-size: 22rpx; color: var(--text-secondary); }
.exp-total {
  font-size: 56rpx; /* Title-1 */
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: -1rpx;
  margin-top: 4rpx;
}
.exp-bar {
  display: flex;
  height: 12rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: var(--bg-fill);
  margin-top: 20rpx;
}
.exp-seg { height: 100%; }
.exp-legend {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 0 0;
}
.exp-lg-name { font-size: 24rpx; color: var(--text-primary); flex: 1; }
.exp-lg-pct { font-size: 22rpx; color: var(--text-tertiary); width: 72rpx; text-align: right; }
.exp-lg-amt { font-size: 24rpx; color: var(--text-secondary); width: 150rpx; text-align: right; }
.exp-none {
  font-size: 24rpx;
  color: var(--text-tertiary);
  text-align: center;
  padding: 32rpx 0 16rpx;
}

.bill-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 112rpx;
}
.bill-main { flex: 1; min-width: 0; }
.bill-t { font-size: 28rpx; color: var(--text-primary); }
.bill-s { font-size: 22rpx; color: var(--text-secondary); margin-top: 4rpx; }
.bill-amt {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  flex: none;
}
.bill-more {
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--pop-deep);
  padding: 20rpx 0 4rpx;
}

/* ---------- 相册 Tab ---------- */
.album-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-secondary);
  padding: 4rpx 36rpx 12rpx;
}
.album {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
  padding: 0 32rpx 24rpx;
}
.album-img {
  width: 100%;
  height: 224rpx;
  border-radius: 16rpx;
  background: var(--bg-fill);
  display: block;
}

/* 按压只变色：hover 规则置于末尾保证覆盖基础底色 */
.chip.chip-hover { background: var(--bg-fill-deep); }
