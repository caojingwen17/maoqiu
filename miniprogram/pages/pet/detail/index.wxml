<!--pages/pet/detail/index.wxml-->
<skeleton wx:if="{{loading}}" type="list" />

<empty-state wx:if="{{loadError}}" image="paw-box" title="加载失败"
  desc="网络开小差了，请重试" btnText="重试" bindbtnTap="reload" />

<block wx:if="{{!loading && !loadError && pet}}">

  <!-- 档案头卡 -->
  <view class="card hd">
    <pet-avatar src="{{pet.avatar || ''}}" species="{{pet.species || 'other'}}" size="112rpx" shape="square" />
    <view class="hd-info">
      <view class="hd-name">{{pet.name}}<text class="hd-gender {{header.genderClass}}">{{header.genderSymbol}}</text></view>
      <view class="hd-line">{{header.breedLine}}</view>
      <view wx:if="{{header.adoptText}}" class="hd-sub">{{header.adoptText}}</view>
    </view>
    <view class="hd-side">
      <view class="hd-edit" bindtap="goEdit" hover-class="txt-hover">编辑</view>
      <view wx:if="{{header.goalText}}" class="pill grey">{{header.goalText}}</view>
    </view>
  </view>

  <!-- 分段选择器（吸顶） -->
  <view class="seg-stick">
    <segmented items="{{tabs}}" current="{{tab}}" bindchange="onTabChange" />
  </view>

  <!-- ========== 时间线 Tab ========== -->
  <block wx:if="{{tab === 0}}">
    <scroll-view scroll-x class="chips" enhanced show-scrollbar="{{false}}">
      <view wx:for="{{filterTabs}}" wx:key="key"
        class="chip {{filter === item.key ? 'on' : ''}}"
        data-key="{{item.key}}" bindtap="onFilterTap" hover-class="chip-hover">{{item.name}}</view>
    </scroll-view>

    <view wx:if="{{groups.length}}" class="card tl-card">
      <view class="tl">
        <block wx:for="{{groups}}" wx:key="key" wx:for-item="group">
          <view class="tl-date">{{group.label}}</view>
          <view wx:for="{{group.items}}" wx:key="_id" wx:for-item="item"
            class="tl-item {{item.collapsing ? 'collapsing' : ''}}" style="--c: {{item.color}};">
            <view class="tl-row" data-id="{{item._id}}"
              bindtap="onRecordTap" bindlongpress="onRecordLongPress" hover-class="row-hover">
              <view class="ticon" style="background: {{item.tint}};">
                <record-icon type="{{item.type}}" size="36rpx" color="{{item.color}}" />
              </view>
              <view class="tl-main">
                <view class="tl-title">{{item.summary}}</view>
                <view wx:if="{{item.sub}}" class="tl-sub">{{item.sub}}</view>
              </view>
              <view wx:if="{{item.hasReminder}}" class="pill warn">已建提醒</view>
            </view>
            <view wx:if="{{item.thumbs.length}}" class="tl-thumbs">
              <image wx:for="{{item.thumbs}}" wx:for-item="src" wx:key="*this"
                class="tl-thumb" src="{{src}}" mode="aspectFill" lazy-load
                data-id="{{item._id}}" data-src="{{src}}" catchtap="onThumbTap" />
            </view>
            <!-- 点击展开的详情卡片 -->
            <view wx:if="{{expandedId === item._id}}" class="tl-detail">
              <view wx:for="{{item.detailLines}}" wx:for-item="line" wx:key="label" class="tl-dline">
                <text class="tl-dk">{{line.label}}</text>
                <text class="tl-dv t-num">{{line.value}}</text>
              </view>
              <view wx:if="{{item.note}}" class="tl-note">{{item.note}}</view>
              <view wx:if="{{item.photos.length}}" class="tl-photos">
                <image wx:for="{{item.photos}}" wx:for-item="src" wx:key="*this"
                  class="tl-photo" src="{{src}}" mode="aspectFill" lazy-load
                  data-id="{{item._id}}" data-src="{{src}}" catchtap="onThumbTap" />
              </view>
            </view>
          </view>
        </block>
      </view>
    </view>

    <empty-state wx:if="{{!groups.length && !timelineError}}" image="calendar"
      title="还没有记录" desc="点右下角 + 记一笔" />
    <empty-state wx:if="{{timelineError}}" image="calendar" title="加载失败"
      desc="网络开小差了，请重试" btnText="重试" bindbtnTap="retryTimeline" />

    <view wx:if="{{groups.length}}" class="list-foot">{{hasMore ? '上拉加载更多' : '已经到底啦'}}</view>
  </block>

  <!-- ========== 健康 Tab ========== -->
  <block wx:if="{{tab === 1}}">
    <view class="card">
      <view class="card-h">
        <text class="card-title">体重趋势</text>
        <text class="card-more">近 90 天</text>
      </view>
      <block wx:if="{{weightPoints.length >= 3}}">
        <canvas type="2d" id="weightChart" class="chart"></canvas>
        <view class="chart-months">
          <text wx:for="{{chartMonths}}" wx:key="*this">{{item}}</text>
        </view>
      </block>
      <view wx:else class="chart-empty">记录 3 次以上体重，就能看到趋势啦</view>
    </view>

    <view class="card secs">
      <block wx:for="{{healthSections}}" wx:key="type">
        <view class="sec-row" data-type="{{item.type}}" bindtap="onSectionTap" hover-class="row-hover">
          <view class="ticon" style="background: {{item.tint}};">
            <record-icon type="{{item.type}}" size="36rpx" color="{{item.color}}" />
          </view>
          <view class="sec-main">
            <view class="sec-title">{{item.title}}</view>
            <view wx:if="{{item.sub}}" class="sec-sub">{{item.sub}}</view>
          </view>
          <view wx:if="{{item.pill}}" class="pill {{item.pill.cls}}">{{item.pill.text}}</view>
          <view wx:else class="chev"
            style="-webkit-mask-image: url('{{chevUri}}'); mask-image: url('{{chevUri}}');"></view>
        </view>
        <view wx:if="{{item.expanded}}" class="sec-list">
          <view wx:for="{{item.list}}" wx:for-item="rec" wx:key="_id" class="sec-rec">
            <text class="sec-rec-t">{{rec.summary}}</text>
            <text class="sec-rec-d">{{rec.dateText}}</text>
          </view>
          <view wx:if="{{!item.list.length}}" class="sec-rec">
            <text class="sec-rec-t sec-rec-empty">暂无记录</text>
          </view>
        </view>
        <view wx:if="{{index < healthSections.length - 1}}" class="hl"></view>
      </block>
    </view>
  </block>

  <!-- ========== 花销 Tab ========== -->
  <block wx:if="{{tab === 2}}">
    <view class="card">
      <view class="exp-label">本月花销</view>
      <view class="exp-total t-num">{{expense.totalText}}</view>
      <block wx:if="{{expense.segments.length}}">
        <view class="exp-bar">
          <view wx:for="{{expense.segments}}" wx:key="key" class="exp-seg"
            style="width: {{item.pct}}%; background: {{item.color}};"></view>
        </view>
        <view wx:for="{{expense.segments}}" wx:key="key" class="exp-legend">
          <view class="dot" style="background: {{item.color}};"></view>
          <text class="exp-lg-name">{{item.name}}</text>
          <text class="exp-lg-pct t-num">{{item.pct}}%</text>
          <text class="exp-lg-amt t-num">{{item.amountText}}</text>
        </view>
      </block>
      <view wx:else class="exp-none">本月还没有花销记录</view>
    </view>

    <view wx:if="{{expense.recent.length}}" class="card">
      <block wx:for="{{expense.recent}}" wx:key="_id">
        <view wx:if="{{index > 0}}" class="hl"></view>
        <view class="bill-row">
          <view class="ticon" style="background: {{expenseIconTint}};">
            <record-icon type="expense" size="36rpx" />
          </view>
          <view class="bill-main">
            <view class="bill-t">{{item.title}}</view>
            <view class="bill-s">{{item.sub}}</view>
          </view>
          <text class="bill-amt t-num">{{item.amountText}}</text>
        </view>
      </block>
      <view class="hl"></view>
      <view class="bill-more" bindtap="goExpenseAll" hover-class="row-hover">查看全部 ›</view>
    </view>
  </block>

  <!-- ========== 相册 Tab ========== -->
  <block wx:if="{{tab === 3}}">
    <block wx:for="{{albumGroups}}" wx:key="key">
      <view class="album-title">{{item.title}} · {{item.photos.length}} 张</view>
      <view class="album">
        <image wx:for="{{item.photos}}" wx:for-item="ph" wx:key="src"
          class="album-img" src="{{ph.src}}" mode="aspectFill" lazy-load
          data-index="{{ph.flatIndex}}" bindtap="onPhotoTap" />
      </view>
    </block>
    <empty-state wx:if="{{!albumGroups.length}}" image="paw-box"
      title="还没有照片" desc="记录时随手拍一张，这里就是成长相册" />
  </block>

</block>

<fab wx:if="{{!loading && !loadError}}" bindtap="goAddRecord"
  style="position: fixed; right: 32rpx; bottom: calc(env(safe-area-inset-bottom) + 48rpx); z-index: 20;" />

<toast id="toast" />
