/* 新增/编辑宠物 */
.head-row {
  display: flex;
  align-items: center;
  gap: 62rpx;
  padding: 40rpx 35rpx;
}
.head-row .photo {
  width: 194rpx;
  height: 194rpx;
  border-radius: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  flex: none;
}
.photo-tip {
  font-size: 22rpx;
  color: var(--pop-deep);
  font-weight: 600;
}
.photo-img {
  width: 100%;
  height: 100%;
  border-radius: 40rpx;
}
.head-fields {
  flex: 1;
  min-width: 0;
}
.head-picker {
  display: block;
}
.head-field .k {
  width: 106rpx;
}
.head-input {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: 31rpx;
  color: var(--text);
  font-weight: 500;
  height: 62rpx;
  line-height: 62rpx;
}
.breed-ph {
  color: var(--t3);
  font-weight: 400;
}
.field-block {
  padding: 24rpx 0 11rpx;
}
.field-label {
  font-size: 26rpx;
  color: var(--t2);
  margin-bottom: 18rpx;
}
.field-hint {
  margin-top: 18rpx;
}
.chips-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}
.trait-input { margin-top:22rpx; height:72rpx; line-height:72rpx; border-bottom:2rpx solid var(--line); color:var(--text); font-size:27rpx; }
.hint {
  font-size: 23rpx;
  color: var(--t3);
  text-align: center;
  line-height: 1.6;
  padding: 0 9rpx;
}
.foot {
  flex: none;
  padding: 13rpx 35rpx 57rpx;
}
