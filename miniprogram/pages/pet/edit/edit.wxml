<view class="page {{themeClass}}">
  <view class="statusbar" style="height:{{sb}}px"></view>
  <view class="nav">
    <view class="back" bindtap="goBack"><p-icon name="chevL" color="{{textColor}}" size="{{44}}" /></view>
    <view class="nt">{{title}}</view>
  </view>

  <view class="body">
    <!-- 头部：左上传头像 + 右名字/生日 -->
    <view class="crd head-row">
      <view class="photo a4" bindtap="onPhoto">
        <image wx:if="{{avatar}}" class="photo-img" src="{{avatar}}" mode="aspectFill" />
        <block wx:else>
          <p-icon name="paw" color="#4A7FC7" size="{{96}}" />
          <text class="photo-tip">上传照片</text>
        </block>
      </view>
      <view class="grow head-fields">
        <view class="frow head-field">
          <text class="k">名字</text>
          <input class="head-input" value="{{name}}" placeholder="给毛孩子起个名" placeholder-class="input-ph" bindinput="onName" />
        </view>
        <view class="hl" style="margin:4rpx 0 4rpx 106rpx"></view>
        <picker class="head-picker" mode="date" value="{{birthDate || '2000-01-01'}}" bindchange="onBirth">
          <view class="frow head-field">
            <text class="k">生日</text>
            <text class="val {{birthDate ? 'b' : 'ph'}}">{{birthDate || '请选择'}}</text>
          </view>
        </picker>
      </view>
    </view>

    <!-- 类型 / 品种 / 性别 -->
    <view class="crd">
      <view class="field-block">
        <view class="field-label">类型</view>
        <view class="chips-wrap">
          <view class="chip {{speciesIdx === index ? 'on' : ''}}" wx:for="{{speciesKeys}}" wx:key="*this" data-name="{{item}}" bindtap="onSpecies">{{item}}</view>
        </view>
      </view>
      <view class="hl-full" style="margin:4rpx -35rpx 4rpx 0"></view>
      <view class="frow" style="min-height:88rpx">
        <text class="k">{{form.breedLabel}}</text>
        <input class="head-input" value="{{breed}}" placeholder="{{form.breed}}" placeholder-class="input-ph" bindinput="onBreed" />
      </view>
      <view class="hl-full" style="margin:4rpx -35rpx 4rpx 0"></view>
      <view class="field-block">
        <view class="field-label">{{form.identity}}</view>
        <view class="chips-wrap">
          <view class="chip {{identityIdx === index ? 'on' : ''}}" wx:for="{{identityChips}}" wx:key="index" data-index="{{index}}" bindtap="onIdentity"><view wx:if="{{item.sym}}" class="g-sym {{item.cls}}"></view>{{item.label}}</view>
        </view>
      </view>
    </view>

    <!-- 性格标签 -->
    <view class="crd">
      <view class="field-block">
        <view class="field-label">性格（最多选 5 个）</view>
        <view class="chips-wrap">
          <view class="chip {{item.on ? 'on' : ''}}" wx:for="{{traitItems}}" wx:key="name" data-trait="{{item.name}}" bindtap="onTrait">{{item.name}}</view>
        </view>
        <input class="trait-input" value="{{customTrait}}" placeholder="也可以自己填写，如：爱撒娇" placeholder-class="input-ph" maxlength="8" bindinput="onCustomTrait" />
      </view>
    </view>

    <!-- 到家日期 / 绝育 -->
    <view class="crd">
      <picker mode="date" value="{{adoptDate || '2000-01-01'}}" bindchange="onAdopt">
        <view class="frow" style="min-height:88rpx">
          <text class="k">到家日期</text>
        <text class="val {{adoptDate ? 'b' : 'ph'}}">{{adoptDate || '请选择'}}</text>
          <view class="chev"><p-icon name="chevR" color="#B9AE9E" size="{{31}}" /></view>
        </view>
      </picker>
      <block wx:if="{{form.needNeutered}}">
        <view class="hl-full" style="margin:4rpx -35rpx 4rpx 0"></view>
        <view class="field-block">
          <view class="field-label">绝育</view>
          <view class="chips-wrap">
            <view class="chip {{neuteredIdx === index ? 'on' : ''}}" wx:for="{{form.neuteredOpts}}" wx:key="*this" data-index="{{index}}" bindtap="onNeutered">{{item}}</view>
          </view>
        </view>
      </block>
    </view>

    <view class="hint">{{form.hint}}</view>
    <view class="hint">填了生日，纪念日前 7 天会提醒全家</view>
  </view>

  <view class="foot">
    <view class="btn btn-p {{saving ? 'btn-off' : ''}}" bindtap="onSave">{{saving ? '保存中…' : (_id ? '保存' : '加入档案袋')}}</view>
  </view>

  <p-toast id="toast"></p-toast>
  <p-cropper show="{{cropShow}}" src="{{cropSrc}}" bind:confirm="onCropConfirm" bind:cancel="onCropCancel" />
  <sub-guide />
</view>
