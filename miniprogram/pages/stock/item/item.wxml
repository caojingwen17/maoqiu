<view class="page {{themeClass}}">
  <view class="statusbar" style="height:{{sb}}px"></view>
  <view class="nav">
    <view class="back" bindtap="goBack"><p-icon name="chevL" color="{{textColor}}" size="{{44}}" /></view>
    <view class="nt">物品详情</view>
  </view>

  <view class="body" wx:if="{{item}}">
    <view class="crd head">
      <view class="ticon" style="background:{{item.color}}1A"><p-icon name="{{item.icon}}" color="{{item.color}}" size="{{48}}" /></view>
      <view class="grow"><view class="t" style="font-size:35rpx;font-weight:700">{{item.name}}</view><view class="s">余量 {{item.remainText}} · {{item.days}}</view></view>
    </view>
    <view class="crd">
      <view class="frow"><text class="k">分类</text><text class="val">{{item.category}}</text></view>
      <view class="frow"><text class="k">日均消耗</text><text class="val b">{{item.dailyConsumeText}}</text></view>
      <view class="frow"><text class="k">补货阈值</text><text class="val">{{item.thresholdText}}</text></view>
      <view class="frow"><text class="k">保质期</text><text class="val b">{{item.expireText}}</text></view>
    </view>
    <view class="btn btn-s" style="margin:0 0 20rpx" bindtap="onEdit">编辑物品</view>
    <view class="crd" wx:if="{{item.logs.length}}">
      <view class="crd-h"><text class="b">消耗记录</text></view>
      <view class="row" wx:for="{{item.logs}}" wx:key="index">
        <view class="grow"><view class="t">{{item.reason}}</view><view class="s">{{item.date}}</view></view>
        <text class="v">-{{item.amount}}</text>
      </view>
    </view>
  </view>

  <view class="foot" wx:if="{{item}}">
    <view class="btn btn-p" bindtap="onConsume">手动消耗</view>
  </view>

  <!-- 手动消耗输入弹窗 -->
  <p-dialog show="{{consumeDlg}}" title="手动消耗" input input-type="digit" input-placeholder="消耗数量（{{item.unit}}）" confirm-text="扣减" bind:input="onConsumeInput" bind:confirm="confirmConsume" bind:cancel="closeConsume" />
  <p-toast id="toast"></p-toast>
  <paw-loading wx:if="{{loading}}" primary="{{true}}" />
</view>
