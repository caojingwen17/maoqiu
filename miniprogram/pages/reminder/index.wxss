/* pages/reminder/index.wxss —— 提醒管理页（对照 doc/index.html「提醒管理」效果图） */

.page {
  padding: 0 32rpx 96rpx;
  /* Info / Danger 的浅底无全局 token，按 §2.3 功能色取 10% 透明度，
     声明为页面级局部变量后统一走 var() 引用（深色单独覆盖） */
  --info-tint: rgba(74, 127, 199, 0.07);
  --danger-tint: rgba(210, 75, 66, 0.10);
}

@media (prefers-color-scheme: dark) {
  .page {
    --info-tint: rgba(74, 127, 199, 0.16);
    --danger-tint: rgba(210, 75, 66, 0.18);
  }
}

/* —— 大标题 + 添加 —— */
.nav-title {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 16rpx 8rpx 24rpx;
}

.large-title {
  font-size: 68rpx;
  font-weight: 700;
  line-height: 1.35;
  color: var(--text-primary);
}

.add-btn {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--primary);
  padding: 8rpx 4rpx;
  transition: color var(--t-press) var(--fade);
}

.add-btn-hover {
  color: var(--primary-pressed);
}

/* —— 订阅消息授权引导条（Info 浅底） —— */
.guide-card {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 24rpx 28rpx;
  border-radius: var(--r-m);
  background: var(--info-tint);
  transition: background var(--t-press) var(--fade);
}

.guide-card-hover {
  background: var(--bg-fill-deep);
}

.guide-icon {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  background: var(--info);
  -webkit-mask-size: contain;
  mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
}

.guide-text {
  flex: 1;
  margin: 0 20rpx;
  font-size: 26rpx;
  color: var(--text-primary);
}

.guide-cta {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--info);
}

/* —— 分组白卡 —— */
.group-card {
  margin-top: 24rpx;
  padding: 8rpx 0;
  border-radius: var(--r-m);
  background: var(--bg-card);
  overflow: hidden;
}

.group-title {
  padding: 20rpx 32rpx 8rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.group-title-danger { color: var(--danger); }
.group-title-today { color: var(--pop-deep); }
.group-title-week { color: var(--text-secondary); }
.group-title-later { color: var(--text-secondary); }

/* —— 提醒行 —— */
.r-row {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: var(--bg-card);
  transition: background var(--t-press) var(--fade);
}

.r-row-hover {
  background: var(--bg-fill-deep);
}

.r-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.r-main {
  flex: 1;
  min-width: 0;
}

.r-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.r-sub {
  margin-top: 4rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.r-row-done .r-title,
.r-row-done .r-sub {
  color: var(--text-tertiary);
}

/* —— 状态 pill —— */
.pill {
  flex-shrink: 0;
  margin-left: 20rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-variant-numeric: tabular-nums;
}

.pill-danger { color: var(--danger); background: var(--danger-tint); }
.pill-warn { color: var(--pop-deep); background: var(--pop-tint); }
.pill-grey { color: var(--text-secondary); background: var(--bg-fill); }

/* —— sheet 表单 —— */
.form {
  padding: 8rpx 32rpx 64rpx;
}

.form-label {
  margin: 32rpx 0 16rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.opt-list {
  border-radius: var(--r-s);
  background: var(--bg-fill);
  overflow: hidden;
}

.opt-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  transition: background var(--t-press) var(--fade);
}

.opt-row-hover {
  background: var(--bg-fill-deep);
}

.opt-on {
  background: var(--primary-tint);
}

.opt-name {
  font-size: 30rpx;
  color: var(--text-primary);
}

.opt-check {
  width: 36rpx;
  height: 36rpx;
  background: var(--primary);
  -webkit-mask-size: contain;
  mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
}

.picker-row {
  padding: 28rpx;
  border-radius: var(--r-s);
  background: var(--bg-fill);
  transition: background var(--t-press) var(--fade);
}

.picker-value {
  font-size: 30rpx;
  color: var(--text-primary);
  font-variant-numeric: tabular-nums;
}

.save-btn {
  margin-top: 56rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: var(--r-m);
  background: var(--primary);
  color: var(--bg-page);
  font-size: 32rpx;
  font-weight: 600;
  transition: background var(--t-press) var(--fade);
}

.save-btn-hover {
  background: var(--primary-pressed);
}
