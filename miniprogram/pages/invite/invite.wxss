/* 邀请落地页 */
.inv-body {
  justify-content: center;
  gap: 31rpx;
}
.inv-head {
  text-align: center;
  padding: 9rpx 0;
}
.inv-inviter {
  font-size: 25rpx;
  color: var(--t2);
}
.inv-name {
  font-size: 46rpx;
  font-weight: 700;
  margin-top: 13rpx;
}
.inv-pets {
  display: flex;
  gap: 22rpx;
}
.inv-pet {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
  padding: 35rpx 22rpx;
}
.inv-pet .avatar {
  width: 114rpx;
  height: 114rpx;
  border-radius: 31rpx;
}
.inv-pet-name {
  font-size: 31rpx;
  font-weight: 700;
}
.inv-members {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 26rpx 31rpx;
}
.inv-avatars {
  display: flex;
  flex: none;
}
.inv-avatars .avatar {
  width: 57rpx;
  height: 57rpx;
  border-radius: 50%;
  margin-left: -18rpx;
  border: 4rpx solid var(--card);
}
.inv-avatars .avatar:first-child {
  margin-left: 0;
}
.inv-consent {
  text-align: center;
  font-size: 23rpx;
  color: var(--t3);
  padding-top: 22rpx;
}

/* 携带我的宠物（加入时按宠物选择性迁入个人空间数据，PRD §16） */
.inv-mine {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 26rpx 31rpx;
}
.inv-mine-h {
  font-size: 29rpx;
  font-weight: 600;
}
.inv-mine-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
}
.mine-av {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  flex: none;
}
.inv-mine-name {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.ck {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 3rpx solid var(--t3);
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.ck.on {
  background: var(--primary);
  border-color: var(--primary);
}
.inv-mine-note {
  font-size: 23rpx;
  color: var(--t3);
  line-height: 1.6;
}
.foot {
  flex: none;
  padding: 13rpx 35rpx 57rpx;
}
.inv-btn-off { opacity: 0.5; }

/* 真实头像图片（无头像时回退爪印图标） */
.avatar-img { width: 100%; height: 100%; border-radius: 50%; }
