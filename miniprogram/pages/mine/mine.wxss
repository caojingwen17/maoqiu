/* 我的·设置 */
.family-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 35rpx;
}
.grow {
  flex: 1;
  min-width: 0;
}
.group-title {
  font-size: 24rpx;
  color: var(--t2);
  padding: 13rpx 9rpx 9rpx;
  font-weight: 600;
}
.no-press {
  cursor: default;
}

/* 推荐给朋友：整行就是 button（open-type=share）。glass-easel 下 wx-button 的内建样式会把
   width/margin 压过普通类选择器（行收缩为内容宽并被居中），关键属性须 !important 压回；
   行内子元素样式依赖 .row 后代选择器，故保留 .row 类，布局属性在此完整覆写 */
.share-btn {
  display: flex !important;
  flex-direction: row !important;
  align-items: center;
  justify-content: flex-start;
  width: 100% !important;
  min-width: 100%;
  margin: 0 !important;
  padding: 20rpx 0;
  min-height: 97rpx;
  gap: 26rpx;
  text-align: left;
  background: none;
  border: 0;
  border-radius: 31rpx;
  transition: background 0.15s;
}
.share-btn:active {
  background: var(--fill);
}

/* 资料编辑弹层 */
.profile-body { padding: 0 35rpx 18rpx; }
.profile-title { font-size: 37rpx; font-weight: 700; text-align: center; }
.profile-sub { text-align: center; margin-top: 9rpx; line-height: 1.6; }
.profile-avatar-crd { display: flex; flex-direction: column; align-items: center; padding: 35rpx 35rpx 31rpx; margin-top: 26rpx; }
.profile-avatar-btn { padding: 0; margin: 0; background: none; display: flex; flex-direction: column; align-items: center; gap: 18rpx; }
.profile-avatar-btn::after { border: none; }
.profile-avatar-tip { font-size: 22rpx; color: var(--pop-deep); font-weight: 600; }
.profile-input { flex: 1; min-width: 0; text-align: right; font-size: 31rpx; color: var(--text); }
.profile-cancel { text-align: center; padding: 31rpx 0 4rpx; color: var(--pop-deep); font-weight: 600; font-size: 31rpx; }