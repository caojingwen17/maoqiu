<view class="page">

  <view class="large-title">我的</view>

  <!-- 品牌卡 -->
  <view class="brand-card">
    <view class="brand-logo" style="-webkit-mask-image: url('{{pawUri}}'); mask-image: url('{{pawUri}}');"></view>
    <view class="brand-main">
      <view class="brand-name">毛球档案袋</view>
      <view class="brand-slogan">{{slogan}}</view>
    </view>
    <view class="pill-grey">{{version}}</view>
  </view>

  <!-- 数据备份卡（Pop-Tint 浅底突出） -->
  <view class="backup-card">
    <view class="backup-icon" style="-webkit-mask-image: url('{{backupUri}}'); mask-image: url('{{backupUri}}');"></view>
    <view class="backup-main">
      <view class="backup-title">数据备份</view>
      <view class="backup-sub">{{backupText}}</view>
    </view>
    <view class="backup-btn" hover-class="backup-btn-hover" bindtap="onBackup">立即备份</view>
  </view>

  <!-- 偏好组 -->
  <view class="group-label">偏好</view>
  <cell-group>
    <cell title="外观模式" value="{{themeText}}" showArrow bindtap="onThemeTap" />
    <cell title="默认提醒周期" value="{{cyclesText}}" showArrow bindtap="onCyclesTap" />
    <cell title="月度预算" value="{{budgetText}}" showArrow bindtap="onBudgetTap" />
  </cell-group>

  <!-- 通用组 -->
  <view class="group-label">通用</view>
  <cell-group>
    <cell title="微信提醒通知" switchChecked="{{notifyOn}}" bindswitchchange="onNotifySwitch" />
    <cell title="归档宠物" value="{{archivedCountText}}" showArrow bindtap="onArchivedTap" />
    <cell title="提醒提前天数" value="{{advanceDaysText}}" showArrow bindtap="onAdvanceTap" />
    <cell title="清除缓存" showArrow bindtap="onClearCache" />
    <!-- 意见反馈：微信客服会话（button open-type=contact，样式对齐 cell 行） -->
    <button class="contact-btn" open-type="contact" hover-class="contact-btn-hover">
      <view class="contact-title">意见反馈</view>
      <view class="contact-arrow" style="-webkit-mask-image: url('{{arrowUri}}'); mask-image: url('{{arrowUri}}');"></view>
    </button>
  </cell-group>

  <!-- 关于 -->
  <view class="group-label">关于</view>
  <cell-group>
    <cell title="关于毛球档案袋" showArrow bindtap="onAboutTap" />
  </cell-group>

  <!-- 外观模式 sheet -->
  <sheet visible="{{themeSheet}}" title="外观模式" bindclose="onCloseSheet" data-sheet="themeSheet">
    <view class="sheet-body">
      <view class="opt-list">
        <view wx:for="{{themeOptions}}" wx:key="key"
          class="opt-row {{theme === item.key ? 'opt-on' : ''}}" data-key="{{item.key}}" bindtap="onThemePick" hover-class="opt-row-hover">
          <view class="opt-name">{{item.name}}</view>
          <view wx:if="{{theme === item.key}}" class="opt-check"
            style="-webkit-mask-image: url('{{checkUri}}'); mask-image: url('{{checkUri}}');"></view>
        </view>
      </view>
    </view>
  </sheet>

  <!-- 默认提醒周期 sheet -->
  <sheet visible="{{cyclesSheet}}" title="默认提醒周期" bindclose="onCloseSheet" data-sheet="cyclesSheet">
    <view class="sheet-body">
      <float-input label="体内驱虫（天）" type="digit" value="{{cyclesForm.dewormInternal}}" bindinput="onCycleInput" data-key="dewormInternal" />
      <float-input label="体外驱虫（天）" type="digit" value="{{cyclesForm.dewormExternal}}" bindinput="onCycleInput" data-key="dewormExternal" />
      <float-input label="疫苗（天）" type="digit" value="{{cyclesForm.vaccine}}" bindinput="onCycleInput" data-key="vaccine" />
      <float-input label="洗澡（天）" type="digit" value="{{cyclesForm.bath}}" bindinput="onCycleInput" data-key="bath" />
      <view class="save-btn" hover-class="save-btn-hover" bindtap="onCyclesSave">保存</view>
    </view>
  </sheet>

  <!-- 月度预算 sheet -->
  <sheet visible="{{budgetSheet}}" title="月度预算" bindclose="onCloseSheet" data-sheet="budgetSheet">
    <view class="sheet-body">
      <float-input label="月度预算（元，0 为不设置）" type="digit" value="{{budgetForm}}" bindinput="onBudgetInput" />
      <view class="save-btn" hover-class="save-btn-hover" bindtap="onBudgetSave">保存</view>
    </view>
  </sheet>

  <!-- 提醒提前天数 sheet -->
  <sheet visible="{{advanceSheet}}" title="提醒提前天数" bindclose="onCloseSheet" data-sheet="advanceSheet">
    <view class="sheet-body">
      <float-input label="提前几天进入待办（0-30 天）" type="digit" value="{{advanceForm}}" bindinput="onAdvanceInput" />
      <view class="save-btn" hover-class="save-btn-hover" bindtap="onAdvanceSave">保存</view>
    </view>
  </sheet>

  <!-- 归档宠物 sheet -->
  <sheet visible="{{archivedSheet}}" title="归档宠物" bindclose="onCloseSheet" data-sheet="archivedSheet">
    <view class="sheet-body">
      <view wx:if="{{archivedList.length === 0}}" class="archived-empty">没有已归档的宠物</view>
      <view wx:for="{{archivedList}}" wx:key="_id" class="archived-row">
        <pet-avatar src="{{item.avatar}}" species="{{item.species}}" size="80rpx" shape="square" />
        <view class="archived-name">{{item.name}}</view>
        <view class="restore-btn" hover-class="restore-btn-hover" data-id="{{item._id}}" bindtap="onRestorePet">恢复</view>
      </view>
    </view>
  </sheet>

  <!-- 关于 sheet -->
  <sheet visible="{{aboutSheet}}" title="关于毛球档案袋" bindclose="onCloseSheet" data-sheet="aboutSheet">
    <view class="sheet-body about-body">
      <view class="about-logo" style="-webkit-mask-image: url('{{pawUri}}'); mask-image: url('{{pawUri}}');"></view>
      <view class="about-name">毛球档案袋</view>
      <view class="about-version">{{version}}</view>
      <view class="about-slogan">{{slogan}}</view>
    </view>
  </sheet>

  <toast id="toast" />
</view>
