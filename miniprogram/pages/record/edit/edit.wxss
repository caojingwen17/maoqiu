/* 记录表单页 */
.pet-head {
  display: flex;
  align-items: center;
  gap: 22rpx;
}
.pet-head .avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
}
.grow { flex: 1; min-width: 0; }
.big-input {
  text-align: center;
  padding: 57rpx 35rpx 44rpx;
}
.big-num {
  font-size: 92rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  letter-spacing: -2rpx;
}
.big-unit {
  font-size: 35rpx;
  font-weight: 500;
  color: var(--t3);
}
.big-hint {
  font-size: 24rpx;
  color: var(--t2);
  margin-top: 13rpx;
}
.daily-ph {
  min-height: 211rpx;
  display: flex;
  align-items: flex-start;
}
.daily-in {
  width: 100%;
  min-height: 140rpx;
  font-size: 32rpx;
  line-height: 1.7;
  color: var(--text);
  padding-top: 8rpx;
}
.daily-ph-t {
  font-size: 32rpx;
  line-height: 1.7;
  color: var(--t3);
}
.album .avatar,
.photo-add {
  aspect-ratio: 1;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.photo-add {
  border: 2rpx dashed var(--t3);
  color: var(--t3);
}
.field-block {
  padding: 24rpx 0 11rpx;
}
.field-label {
  font-size: 26rpx;
  color: var(--t2);
  margin-bottom: 18rpx;
}
.chips-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}
.stock-row .k {
  flex: none;
  width: 167rpx;
}
.foot {
  flex: none;
  padding: 13rpx 35rpx 57rpx;
}
.save-more {
  text-align: center;
  font-size: 29rpx;
  color: var(--pop-deep);
  font-weight: 600;
  padding: 22rpx 0 4rpx;
}
.result-body {
  padding: 0 0 20rpx;
  text-align: center;
}
.result-check {
  width: 97rpx;
  height: 97rpx;
  border-radius: 50%;
  background: rgba(52, 160, 92, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 4rpx auto 22rpx;
}
.result-title {
  font-size: 37rpx;
  font-weight: 700;
}
.result-sub {
  margin-top: 13rpx;
  line-height: 1.6;
}
.result-opt {
  margin-top: 31rpx;
  display: flex;
  align-items: center;
  text-align: left;
  gap: 22rpx;
}
/* 宠物头像图（填充 pet-head 圆形头像位） */
.pet-head .avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

/* 照片缩略图 + 删除角标 */
.photo-strip {
  padding: 0 0 22rpx;
}
.photo-thumb {
  aspect-ratio: 1;
  border-radius: 18rpx;
  overflow: hidden;
  position: relative;
  background: var(--fill);
}
.photo-thumb-img {
  width: 100%;
  height: 100%;
}
.photo-del {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(30, 25, 20, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 视频缩略：无封面时用深色占位底，中央播放角标 */
.video-ph {
  background: #3A332B;
}
.video-badge {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(30, 25, 20, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
}
