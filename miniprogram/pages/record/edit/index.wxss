/* pages/record/edit/index.wxss —— 添加/编辑记录页（§8.3 表单页） */

.page {
  min-height: 100vh;
  padding: 24rpx 0 0;
  box-sizing: border-box;
}

/* —— 分组白卡 —— */
.card {
  background: var(--bg-card);
  border-radius: var(--r-m);
  margin: 0 24rpx 24rpx;
  overflow: hidden;
}

.card-hover { background: var(--bg-fill-deep); }
.row-hover { background: var(--bg-fill-deep); }

/* —— 1.5 类型选择条 —— */
.type-bar {
  margin: 0 0 24rpx;
  white-space: nowrap;
}
.type-row {
  display: inline-flex;
  gap: 16rpx;
  padding: 4rpx 2rpx;
}
.type-chip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  width: 120rpx;
  padding: 18rpx 0 14rpx;
  background: var(--bg-card);
  border-radius: var(--r-s);
}
.type-chip-on {
  background: var(--primary-tint);
  box-shadow: inset 0 0 0 2rpx var(--primary);
}
.type-chip-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}
.type-chip-on .type-chip-label {
  color: var(--text-primary);
  font-weight: 600;
}

/* —— 1. 顶部宠物卡 —— */
.pet-card {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
}

.pet-info {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.pet-name {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.pet-breed {
  margin-top: 4rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* 「换一只」pill */
.pill {
  flex-shrink: 0;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: var(--bg-fill);
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-secondary);
  transition: background var(--t-press) var(--fade);
}

.pill-hover { background: var(--bg-fill-deep); }

/* —— 2. 大数字区 —— */
.big-card {
  text-align: center;
  padding: 52rpx 32rpx 40rpx;
  transition: background var(--t-press) var(--fade);
}

.big-num {
  font-size: 84rpx;
  font-weight: 700;
  letter-spacing: -2rpx;
  line-height: 1.1;
  color: var(--text-primary);
}

.big-empty { color: var(--text-tertiary); }

.big-prefix {
  font-size: 44rpx;
  font-weight: 600;
  margin-right: 8rpx;
}

.big-unit {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-tertiary);
  margin-left: 8rpx;
}

.big-hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

/* —— 3. 字段行：左标签 + 右值/› —— */
.frow {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
  transition: background var(--t-press) var(--fade);
}

.flabel {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.fvalue {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
  text-align: right;
  font-size: 28rpx;
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fvalue-ph { color: var(--text-tertiary); }

/* switch 开关行：推到行右 */
.fswitch { margin-left: auto; }

.fchev {
  width: 28rpx;
  height: 28rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
  opacity: 0.5;
}

/* float-input 行 */
.frow-input {
  position: relative;
  padding: 12rpx 32rpx;
}

/* 纵向行（标签在上，内容在下）：chips / segmented / 标签输入 */
.frow-col {
  position: relative;
  padding: 24rpx 32rpx;
}

.frow-col-label { margin-bottom: 20rpx; }

/* —— Chips —— */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chips-nowrap { flex-wrap: nowrap; }

.chips-scroll { width: 100%; white-space: nowrap; }

.chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: var(--bg-fill);
  font-size: 26rpx;
  color: var(--text-primary);
  transition: background var(--t-press) var(--fade), color var(--t-press) var(--fade);
}

.chip-on {
  background: var(--primary);
  color: var(--bg-page);
}

.chip-close {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.7;
}

/* 标签输入框 */
.tag-input {
  flex: 1;
  min-width: 200rpx;
  height: 56rpx;
  font-size: 26rpx;
  color: var(--text-primary);
}

.tag-input-ph { color: var(--text-tertiary); }

/* —— 4~6. 照片 / 换算 / 备注 —— */
.photo-card { padding: 24rpx 32rpx 32rpx; }

.photo-hint {
  margin-bottom: 16rpx;
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.convert-card { padding: 16rpx 32rpx; }

.convert-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.convert-input { flex: 1; min-width: 0; }

.convert-btn {
  flex-shrink: 0;
  padding: 14rpx 28rpx;
  border-radius: var(--r-l);
  background: var(--primary-tint);
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary);
  transition: opacity var(--t-press) var(--fade);
}

.btn-hover { opacity: 0.85; }

.note-card { padding: 12rpx 32rpx; }

/* —— 花销「医疗」就医联动提示条 —— */
.banner {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 0 24rpx 24rpx;
  padding: 24rpx 32rpx;
  background: var(--bg-card);
  border-radius: var(--r-m);
  transition: background var(--t-press) var(--fade);
}

.banner-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}

/* —— 7. 吸底按钮区 —— */
.footer-space {
  height: calc(260rpx + env(safe-area-inset-bottom));
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
}

/* 按钮上方透明到 BG-Page 渐变遮罩（内容淡出，§7.5 允许的渐变） */
.footer-mask {
  height: 48rpx;
  background: linear-gradient(to bottom, rgba(250, 246, 239, 0), var(--bg-page));
}

.footer-body {
  background: var(--bg-page);
  padding: 8rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
}

/* Primary 主按钮：炭棕实心 + 米白字，高 100rpx，radius-l */
.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100rpx;
  border-radius: var(--r-l);
  background: var(--primary);
  color: var(--bg-page);
  font-size: 32rpx;
  font-weight: 600;
  transition: opacity var(--t-press) var(--fade), background var(--t-press) var(--fade);
}

.btn-primary-hover {
  opacity: 0.85;
  background: var(--primary-pressed);
}

/* 提交中：spinner 替换文字，宽度不变 */
.btn-saving { opacity: 0.9; }

/* 「保存并再记一条」Pop-Deep 文字按钮 */
.btn-again {
  text-align: center;
  padding: 20rpx 0 4rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--pop-deep);
  transition: opacity var(--t-press) var(--fade);
}

.again-hover { opacity: 0.6; }

/* —— 宠物选择弹层 —— */
.pet-list {
  max-height: 60vh;
  padding: 0 32rpx 32rpx;
  box-sizing: border-box;
}

.pet-item {
  display: flex;
  align-items: center;
  padding: 20rpx 16rpx;
  border-radius: var(--r-s);
  transition: background var(--t-press) var(--fade);
}

.pet-item-on { background: var(--primary-tint); }

.pet-empty {
  padding: 48rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: var(--text-tertiary);
}
