<!--pages/record/edit/index.wxml-->
<!-- 16 种记录类型共用骨架：宠物卡 → 大数字区 → 类型字段卡 → 日期时间 → 照片 → 备注 → 吸底按钮 -->
<view class="page">

  <!-- 1. 顶部宠物卡 -->
  <view class="card pet-card">
    <pet-avatar src="{{pet.avatar || ''}}" species="{{pet.species || 'other'}}" size="96rpx" />
    <view class="pet-info">
      <view class="pet-name">{{pet ? pet.name : '选择宠物'}}</view>
      <view class="pet-breed">{{pet ? speciesName : '点右侧挑一只毛孩子'}}</view>
    </view>
    <view wx:if="{{!petLocked}}" class="pill" hover-class="pill-hover" bindtap="onOpenPetSheet">换一只</view>
  </view>

  <!-- 1.5 类型选择条（type 未锁定时显示，如详情页 FAB 直入） -->
  <scroll-view wx:if="{{!typeLocked}}" scroll-x enhanced show-scrollbar="{{false}}" class="type-bar">
    <view class="type-row">
      <view wx:for="{{typeList}}" wx:key="type" data-type="{{item.type}}"
        class="type-chip {{item.type === type ? 'type-chip-on' : ''}}"
        hover-class="row-hover" bindtap="onTypeChipTap">
        <record-icon type="{{item.type}}" size="40rpx" />
        <text class="type-chip-label">{{item.label}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 2. 大数字区（体重/金额，Title-1 tabular-nums，点击唤 num-keyboard） -->
  <view wx:if="{{bigView}}" class="card big-card" hover-class="card-hover" bindtap="onBigTap">
    <view class="big-num t-num {{bigView.empty ? 'big-empty' : ''}}">
      <text wx:if="{{bigView.prefix}}" class="big-prefix">{{bigView.prefix}}</text>{{bigView.display}}<text class="big-unit">{{bigView.unit}}</text>
    </view>
    <view class="big-hint">{{bigView.hint}}</view>
  </view>

  <!-- 3. 类型专属字段卡（iOS 分组白卡 + hairline 左缩进） -->
  <view class="card" wx:if="{{fieldsView.length}}">
    <block wx:for="{{fieldsView}}" wx:key="key" wx:for-item="item" wx:for-index="idx">

      <!-- number：数字行，点击唤 num-keyboard -->
      <view wx:if="{{item.kind === 'number'}}"
        class="frow {{idx < fieldsView.length - 1 || customVaccine ? 'hairline-b' : ''}}"
        hover-class="row-hover" data-key="{{item.key}}" bindtap="onNumberTap">
        <text class="flabel">{{item.label}}</text>
        <text class="fvalue {{item.filled ? '' : 'fvalue-ph'}}">{{item.filled ? item.display : '选填'}}</text>
        <image class="fchev" src="{{chevUri}}" mode="aspectFit" />
      </view>

      <!-- date：picker mode=date 行 -->
      <picker wx:elif="{{item.kind === 'date'}}" mode="date"
        value="{{item.pickerValue}}" data-key="{{item.key}}" bindchange="onFieldDate">
        <view class="frow {{idx < fieldsView.length - 1 || customVaccine ? 'hairline-b' : ''}}" hover-class="row-hover">
          <text class="flabel">{{item.label}}</text>
          <text class="fvalue {{item.filled ? '' : 'fvalue-ph'}}">{{item.filled ? item.display : '请选择'}}</text>
          <image class="fchev" src="{{chevUri}}" mode="aspectFit" />
        </view>
      </picker>

      <!-- text：float-input -->
      <view wx:elif="{{item.kind === 'text'}}"
        class="frow-input {{idx < fieldsView.length - 1 || customVaccine ? 'hairline-b' : ''}}">
        <float-input label="{{item.label}}" value="{{item.text}}" data-key="{{item.key}}" bindinput="onTextInput" />
      </view>

      <!-- select sheet：点击行弹 ActionSheet -->
      <view wx:elif="{{item.kind === 'select' && !item.chips}}"
        class="frow {{idx < fieldsView.length - 1 || customVaccine ? 'hairline-b' : ''}}"
        hover-class="row-hover" data-key="{{item.key}}" bindtap="onSelectSheet">
        <text class="flabel">{{item.label}}</text>
        <text class="fvalue {{item.filled ? '' : 'fvalue-ph'}}">{{item.filled ? item.display : '请选择'}}</text>
        <image class="fchev" src="{{chevUri}}" mode="aspectFit" />
      </view>

      <!-- select chips：Chip 单排横选 / 换行 -->
      <view wx:elif="{{item.kind === 'select' && item.chips}}"
        class="frow-col {{idx < fieldsView.length - 1 || customVaccine ? 'hairline-b' : ''}}">
        <view class="flabel frow-col-label">{{item.label}}</view>
        <scroll-view wx:if="{{item.single}}" scroll-x enhanced show-scrollbar="{{false}}" class="chips-scroll">
          <view class="chips chips-nowrap">
            <view wx:for="{{item.chips}}" wx:for-item="chip" wx:key="value"
              class="chip {{chip.on ? 'chip-on' : ''}}"
              data-key="{{item.key}}" data-value="{{chip.value}}" bindtap="onChip">
              <record-icon wx:if="{{chip.icon}}" type="{{chip.icon}}" size="32rpx"
                color="{{chip.on ? 'var(--bg-page)' : ''}}" />
              <text class="chip-text">{{chip.label}}</text>
            </view>
          </view>
        </scroll-view>
        <view wx:else class="chips">
          <view wx:for="{{item.chips}}" wx:for-item="chip" wx:key="value"
            class="chip {{chip.on ? 'chip-on' : ''}}"
            data-key="{{item.key}}" data-value="{{chip.value}}" bindtap="onChip">
            <record-icon wx:if="{{chip.icon}}" type="{{chip.icon}}" size="32rpx"
              color="{{chip.on ? 'var(--bg-page)' : ''}}" />
            <text class="chip-text">{{chip.label}}</text>
          </view>
        </view>
      </view>

      <!-- multiselect：Chip 多选 -->
      <view wx:elif="{{item.kind === 'multiselect'}}"
        class="frow-col {{idx < fieldsView.length - 1 || customVaccine ? 'hairline-b' : ''}}">
        <view class="flabel frow-col-label">{{item.label}}</view>
        <view class="chips">
          <view wx:for="{{item.chips}}" wx:for-item="chip" wx:key="value"
            class="chip {{chip.on ? 'chip-on' : ''}}"
            data-key="{{item.key}}" data-value="{{chip.value}}" bindtap="onChip">
            <text class="chip-text">{{chip.label}}</text>
          </view>
        </view>
      </view>

      <!-- segmented：分段选择器 -->
      <view wx:elif="{{item.kind === 'segmented'}}"
        class="frow-col {{idx < fieldsView.length - 1 || customVaccine ? 'hairline-b' : ''}}">
        <view class="flabel frow-col-label">{{item.label}}</view>
        <segmented items="{{item.segItems}}" current="{{item.segIndex}}"
          data-key="{{item.key}}" bindchange="onSegmented" />
      </view>

      <!-- switch：开关行（原生 switch 的 color 属性不支持 CSS 变量，写死 --primary 字面色值） -->
      <view wx:elif="{{item.kind === 'switch'}}"
        class="frow {{idx < fieldsView.length - 1 || customVaccine ? 'hairline-b' : ''}}">
        <text class="flabel">{{item.label}}</text>
        <switch class="fswitch" checked="{{item.checked}}" color="#3E362C"
          data-key="{{item.key}}" bindchange="onSwitchRow" />
      </view>

      <!-- chips-input：标签输入（自定义症状等），点标签删除 -->
      <view wx:elif="{{item.kind === 'chips-input'}}"
        class="frow-col {{idx < fieldsView.length - 1 || customVaccine ? 'hairline-b' : ''}}">
        <view class="flabel frow-col-label">{{item.label}}</view>
        <view class="chips">
          <view wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this"
            class="chip chip-on" data-key="{{item.key}}" data-value="{{tag}}" bindtap="onTagRemove">
            <text class="chip-text">{{tag}}</text>
            <image class="chip-close" src="{{closeUri}}" mode="aspectFit" />
          </view>
          <input class="tag-input" value="{{item.tagInput}}" placeholder="{{item.placeholder}}"
            placeholder-class="tag-input-ph" confirm-type="done"
            data-key="{{item.key}}" bindinput="onTagInput" bindconfirm="onTagAdd" />
        </view>
      </view>

    </block>

    <!-- 疫苗选「自定义」：转 text 输入 -->
    <view wx:if="{{customVaccine}}" class="frow-input">
      <float-input label="自定义疫苗名称" value="{{form.vaccineNameCustom}}"
        data-key="vaccineNameCustom" bindinput="onTextInput" />
    </view>
  </view>

  <!-- 4. 日期时间行（默认此刻，不可选未来） -->
  <view class="card">
    <picker mode="date" value="{{dateStr}}" end="{{todayStr}}" bindchange="onDateChange">
      <view class="frow hairline-b" hover-class="row-hover">
        <text class="flabel">日期</text>
        <text class="fvalue">{{dateStr}}{{isToday ? ' · 今天' : ''}}</text>
        <image class="fchev" src="{{chevUri}}" mode="aspectFit" />
      </view>
    </picker>
    <picker mode="time" value="{{timeStr}}" bindchange="onTimeChange">
      <view class="frow" hover-class="row-hover">
        <text class="flabel">时间</text>
        <text class="fvalue">{{timeStr}}</text>
        <image class="fchev" src="{{chevUri}}" mode="aspectFit" />
      </view>
    </picker>
  </view>

  <!-- 5. 照片（≤9 张，就医带上传引导） -->
  <view class="card photo-card">
    <view wx:if="{{type === 'medical'}}" class="photo-hint">可上传：化验单 / 处方 / 伤口</view>
    <photo-picker photos="{{photos}}" max="{{9}}" bindchange="onPhotos" />
  </view>

  <!-- 体重专属：斤 → kg 快捷换算行（备注上方） -->
  <view wx:if="{{type === 'weight'}}" class="card convert-card">
    <view class="convert-row">
      <view class="convert-input">
        <float-input label="按「斤」输入，一键换算" type="digit" value="{{jinText}}"
          bindinput="onJinInput" bindconfirm="onConvertJin" />
      </view>
      <view class="convert-btn" hover-class="btn-hover" bindtap="onConvertJin">换成 kg</view>
    </view>
  </view>

  <!-- 6. 备注（≤500 字） -->
  <view class="card note-card">
    <float-input label="备注（选填，500 字内）" type="textarea" value="{{note}}" bindinput="onNote" />
  </view>

  <!-- 花销选「医疗」：就医联动提示条 -->
  <view wx:if="{{showMedicalBanner}}" class="banner" hover-class="row-hover" bindtap="onMedicalBanner">
    <record-icon type="medical" size="40rpx" />
    <text class="banner-text">要不要同时记一条就医记录？</text>
    <image class="fchev" src="{{chevUri}}" mode="aspectFit" />
  </view>

  <!-- 底部占位（吸底按钮高度 + safe-area） -->
  <view class="footer-space" />

  <!-- 7. 吸底：渐变遮罩 + Primary 保存 + Pop-Deep 文字按钮 -->
  <view class="footer">
    <view class="footer-mask" />
    <view class="footer-body">
      <view class="btn-primary {{saving ? 'btn-saving' : ''}}" hover-class="btn-primary-hover" bindtap="onSave">
        <paw-loading wx:if="{{saving}}" variant="spinner" />
        <text wx:else>保存</text>
      </view>
      <view wx:if="{{!isEdit}}" class="btn-again" hover-class="again-hover" bindtap="onSaveContinue">保存并再记一条</view>
    </view>
  </view>

  <!-- 宠物选择半屏弹层 -->
  <sheet visible="{{petSheet}}" title="选择宠物" bindclose="onClosePetSheet">
    <scroll-view scroll-y class="pet-list">
      <view wx:for="{{petList}}" wx:key="_id"
        class="pet-item {{item._id === petId ? 'pet-item-on' : ''}}"
        hover-class="row-hover" data-id="{{item._id}}" bindtap="onPickPet">
        <pet-avatar src="{{item.avatar}}" species="{{item.species}}" size="80rpx" shape="circle" />
        <view class="pet-info">
          <view class="pet-name">{{item.name}}</view>
          <view class="pet-breed">{{item.breed}}</view>
        </view>
      </view>
      <view wx:if="{{!petList.length}}" class="pet-empty">还没有宠物，先去首页添加一只吧</view>
    </scroll-view>
  </sheet>

  <!-- 大数字键盘（体重/金额/各数字行共用） -->
  <num-keyboard visible="{{kb.visible}}" mode="{{kb.mode}}" max="{{kb.max}}" unit="{{kb.unit}}"
    bindconfirm="onKbConfirm" bindclose="onKbClose" />

  <toast id="toast" />
</view>
