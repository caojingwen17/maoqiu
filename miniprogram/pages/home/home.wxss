/* 首页卡片墙（对齐原型 V.home） */
.kicked-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: var(--bg);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 70rpx;
}
.kicked-card {
  width: 100%;
  background: var(--card);
  border-radius: 31rpx;
  padding: 66rpx 35rpx 57rpx;
}
.home-title {
  display: flex;
  align-items: flex-end;
  gap: 22rpx;
  padding: 13rpx 44rpx 22rpx;
  flex: none;
}
.home-title .large-title {
  flex: 1;
  padding: 0;
}
.home-title .members {
  display: flex;
  flex: none;
  margin-bottom: 20rpx;
}
.home-title .members .avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  margin-left: -15rpx;
  border: 4rpx solid var(--bg);
}
.home-title .members .avatar:first-child {
  margin-left: 0;
}
.av-a1 { background: #F3E4D3; }
.av-a2 { background: #E5E9E2; }
.av-a3 { background: #EFE3E3; }
.av-a4 { background: #E2E8F1; }

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}
.pet-avatar-img { object-fit: contain; background: var(--fill); }
.members-more {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--t2);
}
.pet-gender {
  font-size: 26rpx;
  color: var(--t3);
  font-weight: 400;
}
.pet-gender.m { color: var(--info); }
.pet-gender.f { color: var(--pink); }

/* 动作弹层（待办 / 宠物编辑 / 引导共用） */
.act-head {
  text-align: center;
  margin-bottom: 31rpx;
}
.act-title {
  font-size: 35rpx;
  font-weight: 700;
}
.act-sub {
  font-size: 24rpx;
  color: var(--t2);
  margin-top: 9rpx;
  line-height: 1.6;
}
.act-cancel {
  text-align: center;
  padding: 31rpx 0 4rpx;
  color: var(--pop-deep);
  font-weight: 600;
  font-size: 31rpx;
}

/* 首宠引导步骤点 */
.todo-avatar {
  width: 66rpx;
  height: 66rpx;
  border-radius: 50%;
}

/* 今日待办标题行右侧：忽略全部（弱化文字按钮，不抢「全部提醒」视觉） */
.crd-h-side {
  display: flex;
  align-items: center;
  gap: 26rpx;
}
.todo-ignore-all {
  color: var(--t3);
}
.todo-ignore-all.off {
  opacity: 0.5;
}

.pet-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
}
.pet-row .avatar {
  width: 97rpx;
  height: 97rpx;
  border-radius: 50%;
}
.pet-name {
  font-size: 33rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 13rpx;
}
.pet-breed {
  font-size: 22rpx;
  color: var(--t2);
  margin-top: 4rpx;
}
.pet-age {
  font-size: 20rpx;
  color: var(--t3);
  margin-top: 2rpx;
}
.pet-meta {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}
.pet-card-single { padding: 36rpx 29rpx 28rpx; }
.single-head { display:flex; align-items:center; gap:28rpx; }
.single-avatar { width:144rpx !important; height:144rpx !important; border-radius:50%; flex:none; }
.single-name { font-size:40rpx; }
.single-info { display:flex; gap:54rpx; align-items:flex-start; }
.single-info > view { display:flex; flex-direction:column; gap:7rpx; }
.single-label { font-size:21rpx; color:var(--t3); }
.trait-mini { display:flex; flex-wrap:wrap; gap:8rpx; }
.trait-mini text { font-size:21rpx; color:var(--pop-deep); background:var(--primary-tint); border-radius:999rpx; padding:5rpx 12rpx; }
.single-next { margin-top:24rpx; color:var(--t2); font-size:23rpx; display:flex; align-items:center; gap:9rpx; }
.pet-long-hint { text-align:center; color:var(--t3); font-size:21rpx; margin:20rpx 0 4rpx; }
.pet-weight {
  font-size: 31rpx;
  font-weight: 700;
}
.pet-todo {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--t3);
}
.diary-hint { color: var(--pop-deep); }

/* 显示已归档开关 + 归档卡片弱化 */
.archived-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 6rpx 18rpx;
}
.archived-toggle-label {
  font-size: 24rpx;
  color: var(--t2);
}
.pet-card.archived {
  opacity: 0.55;
}
.archived-tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
}

/* 快捷记录九宫格弹层 */
.qa-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 26rpx;
}
.qa-title {
  font-size: 35rpx;
  font-weight: 700;
}
.qa-pets {
  display: flex;
  gap: 13rpx;
  align-items: center;
}
.qa-pet {
  display: flex;
  align-items: center;
  gap: 11rpx;
  padding: 9rpx 22rpx 9rpx 9rpx;
  border-radius: 999rpx;
  background: var(--fill);
}
.qa-pet .avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
}
.qa-pet text {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--t2);
}
.qa-pet.on {
  background: var(--primary-tint);
  box-shadow: inset 0 0 0 3rpx var(--primary);
}
.qa-pet.on text {
  font-weight: 600;
  color: var(--text);
}
.qa-swiper {
  height: 590rpx;
}
.qa-dots {
  display: flex;
  justify-content: center;
  gap: 11rpx;
  margin-top: 26rpx;
}
.qa-dots .dot {
  width: 18rpx;
  height: 18rpx;
  background: var(--t3);
  border-radius: 999rpx;
}
.qa-dots .dot.on {
  background: var(--primary);
  width: 31rpx;
}
/* tab 页可视区域底部即 tabBar 顶边，无需额外抬高；与右边距一致（35rpx） */
.fab {
  bottom: 35rpx;
}
