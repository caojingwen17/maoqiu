/* pages/calendar/index.wxss —— 日历页（设计文档 §8.5） */
.page {
  padding: 0 32rpx 48rpx;
}

.large-title {
  padding: 12rpx 0 24rpx;
  font-size: 68rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  color: var(--text-primary);
}

.card {
  background: var(--bg-card);
  border-radius: var(--r-m);
  padding: 24rpx 24rpx 28rpx;
}

/* —— 月份头 —— */
.cal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 4rpx 16rpx;
}

.cal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.chev {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
}

/* 按压只变色不缩放（§5.3） */
.chev:active {
  background: var(--bg-fill-deep);
}

.chev-ic {
  width: 32rpx;
  height: 32rpx;
}

/* 左箭头复用 chevron-right 旋转 */
.chev-flip {
  transform: rotate(180deg);
}

/* —— 月历网格 —— */
.cal-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 4rpx;
}

.wk {
  padding: 8rpx 0;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.d {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 96rpx;
  padding-top: 10rpx;
  border-radius: 16rpx;
}

.d:active {
  background: var(--bg-fill-deep);
}

.num {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--text-primary);
  font-variant-numeric: tabular-nums;
}

/* 非本月灰字 */
.d.dim .num {
  color: var(--text-tertiary);
}

/* 今天：Primary 实心圆白字（深色模式随 primary 反转） */
.num.today {
  background: var(--primary);
  color: var(--bg-page);
  font-weight: 600;
}

/* 选中非今天：Pop-Tint 圆底 */
.d.sel {
  background: var(--pop-tint);
}

/* 事件圆点：8rpx 类型色，最多 3 个居中 */
.dots {
  display: flex;
  gap: 5rpx;
  height: 8rpx;
  margin-top: 6rpx;
}

.dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 999rpx;
}

.dot-health { background: var(--danger); }   /* 健康 #D24B42 */
.dot-feed { background: var(--success); }    /* 喂养 #34A05C */
.dot-expense { background: var(--pop); }     /* 花销 #C08A4E */
.dot-reminder { background: var(--info); }   /* 提醒 #4A7FC7 */

/* —— 当日 sheet —— */
.sec-label {
  padding: 24rpx 0 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

.row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 88rpx;
  padding: 12rpx 0;
}

.row-grow {
  flex: 1;
  min-width: 0;
}

.row-t {
  font-size: 28rpx;
  color: var(--text-primary);
}

.row-time {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.pill {
  flex: none;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  white-space: nowrap;
}

.pill-warn {
  color: var(--pop-deep);
  background: var(--pop-tint);
}

.pill-danger {
  color: var(--danger);
  background: var(--pop-tint);
}

.done-btn {
  flex: none;
  padding: 8rpx 4rpx 8rpx 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--pop-deep);
}

.done-btn:active {
  color: var(--text-secondary);
}

.day-empty {
  padding: 96rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: var(--text-secondary);
}
