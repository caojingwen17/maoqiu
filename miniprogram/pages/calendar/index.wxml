<!--pages/calendar/index.wxml-->
<view class="page">
  <view class="large-title">日历</view>

  <skeleton type="card" wx:if="{{loading}}" />

  <view wx:elif="{{loadFail}}" class="card">
    <empty-state image="calendar" title="日历加载失败" desc="网络开小差了，请重试" btnText="重试" bindbtnTap="onRetry" />
  </view>

  <view wx:else class="card cal-card">
    <!-- 月份头：左右切月 + 年月标题 -->
    <view class="cal-head">
      <view class="chev" bindtap="prevMonth">
        <image class="chev-ic chev-flip" src="{{chevUri}}" mode="aspectFit" />
      </view>
      <view class="cal-title">{{monthTitle}}</view>
      <view class="chev" bindtap="nextMonth">
        <image class="chev-ic" src="{{chevUri}}" mode="aspectFit" />
      </view>
    </view>

    <!-- 周头 + 7 列网格 -->
    <view class="cal-grid">
      <view class="wk" wx:for="{{['一','二','三','四','五','六','日']}}" wx:key="*this">{{item}}</view>
      <view
        wx:for="{{cells}}"
        wx:key="key"
        class="d {{item.dim ? 'dim' : ''}} {{item.selected && !item.today ? 'sel' : ''}}"
        data-ts="{{item.ts}}"
        bindtap="onDayTap"
      >
        <view class="num {{item.today ? 'today' : ''}}">{{item.day}}</view>
        <view class="dots">
          <view wx:for="{{item.dots}}" wx:for-item="dot" wx:key="*this" class="dot dot-{{dot}}"></view>
        </view>
      </view>
    </view>
  </view>
</view>

<!-- 当日详情：half 档 sheet，不跳页 -->
<sheet visible="{{sheetVisible}}" title="{{dayTitle}}" height="half" bindclose="onSheetClose">
  <view wx:if="{{dayEmpty}}" class="day-empty">这一天静悄悄</view>

  <block wx:if="{{dayRecords.length}}">
    <view class="sec-label">记录</view>
    <view class="row" wx:for="{{dayRecords}}" wx:key="id">
      <record-icon type="{{item.iconType}}" size="48rpx" />
      <view class="row-grow">
        <view class="row-t">{{item.summary}}</view>
      </view>
      <view class="row-time t-num">{{item.time}}</view>
    </view>
  </block>

  <block wx:if="{{dayReminders.length}}">
    <view class="sec-label">提醒</view>
    <view class="row" wx:for="{{dayReminders}}" wx:key="id">
      <record-icon type="{{item.iconType}}" size="48rpx" />
      <view class="row-grow">
        <view class="row-t">{{item.title}}</view>
      </view>
      <view class="pill {{item.overdue ? 'pill-danger' : 'pill-warn'}}">{{item.dueText}}</view>
      <view class="done-btn" data-id="{{item.id}}" bindtap="onCompleteReminder">完成</view>
    </view>
  </block>
</sheet>

<toast id="toast" />
