/* pages/stats/index.wxss —— 统计页（设计文档 §8.4） */
.page {
  padding: 0 32rpx 64rpx;
}

.large-title {
  padding: 12rpx 0 20rpx;
  font-size: 68rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  color: var(--text-primary);
}

/* —— 宠物筛选 Chip —— */
.chips {
  white-space: nowrap;
  margin: 0 -32rpx;
  padding: 0 32rpx 16rpx;
  box-sizing: border-box;
}

.chip {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border-radius: var(--r-s);
  background: var(--bg-fill);
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* 按压只变色不缩放（§5.3） */
.chip:active {
  background: var(--bg-fill-deep);
}

.chip.on {
  background: var(--primary);
  color: var(--bg-page);
  font-weight: 600;
}

/* —— 卡片 —— */
.card {
  margin-top: 24rpx;
  padding: 28rpx 32rpx;
  background: var(--bg-card);
  border-radius: var(--r-m);
}

.card-h {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.card-t {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.card-s {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.chart {
  width: 100%;
  height: 400rpx;
}

/* —— 花销柱状（柱顶 radius-full，当前月 Primary 其余 Primary-Tint） —— */
.bars {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
  height: 200rpx;
}

.bar-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.bar-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.bar {
  border-radius: 999rpx 999rpx 8rpx 8rpx;
  background: var(--primary-tint);
}

.bar.cur {
  background: var(--primary);
}

/* 下钻选中态：非当前月选中时用 Primary-Mid 提示 */
.bar.sel:not(.cur) {
  background: var(--primary-mid);
}

.bar-label {
  padding-top: 10rpx;
  text-align: center;
  font-size: 20rpx;
  color: var(--text-tertiary);
}

/* —— 下钻分类占比 —— */
.drill {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1px solid var(--hairline);
}

.drill-title {
  margin-bottom: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

.drill-empty {
  padding: 24rpx 0 8rpx;
  font-size: 26rpx;
  color: var(--text-tertiary);
}

.drill-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 8rpx 0;
}

.drill-name {
  flex: none;
  width: 72rpx;
  font-size: 26rpx;
  color: var(--text-primary);
}

.drill-track {
  flex: 1;
  height: 12rpx;
  border-radius: 999rpx;
  background: var(--bg-fill);
  overflow: hidden;
}

.drill-fill {
  height: 100%;
  border-radius: 999rpx;
  transition: width 350ms var(--snap);
}

.drill-amt {
  flex: none;
  width: 140rpx;
  text-align: right;
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* —— 打卡热力（14 列 × 7 行） —— */
.heat {
  display: grid;
  grid-template-columns: repeat(14, 1fr);
  gap: 6rpx;
}

.heat-cell {
  aspect-ratio: 1;
  border-radius: 6rpx;
}

/* 热力四档：lv0 走 fill token；pop 的 25%/50% 无对应 token，写字面量（同效果图） */
.lv0 { background: var(--bg-fill); }
.lv1 { background: rgba(192, 138, 78, 0.25); }
.lv2 { background: rgba(192, 138, 78, 0.5); }
.lv3 { background: var(--pop); }

.heat-legend {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  margin-top: 16rpx;
  font-size: 20rpx;
  color: var(--text-tertiary);
}

.heat-legend .heat-cell {
  width: 18rpx;
  height: 18rpx;
}
