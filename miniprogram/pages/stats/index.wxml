<!--pages/stats/index.wxml-->
<view class="page">
  <view class="large-title">统计</view>

  <!-- 宠物筛选 Chip（横向滚动） -->
  <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="chips">
    <view
      wx:for="{{petChips}}"
      wx:key="_id"
      class="chip {{petId === item._id ? 'on' : ''}}"
      data-id="{{item._id}}"
      bindtap="onPetChip"
    >{{item.name}}</view>
  </scroll-view>

  <!-- 时间范围 -->
  <segmented items="{{rangeItems}}" current="{{rangeIndex}}" bindchange="onRange" />

  <skeleton type="card" wx:if="{{loading}}" />

  <view wx:elif="{{loadFail}}" class="card">
    <empty-state image="chart" title="统计数据加载失败" desc="网络开小差了，请重试" btnText="重试" bindbtnTap="onRetry" />
  </view>

  <block wx:else>
    <!-- 体重曲线卡 -->
    <view class="card">
      <view class="card-h">
        <text class="card-t">体重曲线</text>
        <text class="card-s">{{weightSub}}</text>
      </view>
      <empty-state wx:if="{{weightEmpty}}" image="chart" title="记录 3 次以上体重，就能看到趋势啦" />
      <canvas
        wx:else
        type="2d"
        id="weightChart"
        class="chart"
        disable-scroll="{{true}}"
        bindlongpress="onProbeStart"
        bindtouchmove="onProbeMove"
        bindtouchend="onProbeEnd"
        bindtouchcancel="onProbeEnd"
      ></canvas>
    </view>

    <!-- 花销趋势卡 -->
    <view class="card">
      <view class="card-h">
        <text class="card-t">花销趋势</text>
        <text class="card-s">{{expenseSub}}</text>
      </view>
      <view class="bars" wx:if="{{bars.length}}">
        <view
          class="bar-col"
          wx:for="{{bars}}"
          wx:key="month"
          data-month="{{item.month}}"
          bindtap="onBarTap"
        >
          <view class="bar-wrap">
            <view
              class="bar {{item.current ? 'cur' : ''}} {{selectedMonth === item.month ? 'sel' : ''}}"
              style="height: {{item.heightPct}}%;"
            ></view>
          </view>
          <view class="bar-label">{{item.label}}</view>
        </view>
      </view>

      <!-- 下钻：该月分类占比 -->
      <view class="drill" wx:if="{{selectedMonth}}">
        <view class="drill-title">{{selectedMonthLabel}}分类占比</view>
        <view wx:if="{{drillEmpty}}" class="drill-empty">该月暂无分类明细</view>
        <view class="drill-row" wx:for="{{drillList}}" wx:key="key">
          <view class="drill-name">{{item.name}}</view>
          <view class="drill-track">
            <view class="drill-fill" style="width: {{item.pct}}%; background: {{item.color}};"></view>
          </view>
          <view class="drill-amt t-num">{{item.amountText}}</view>
        </view>
      </view>
    </view>

    <!-- 打卡热力卡 -->
    <view class="card">
      <view class="card-h">
        <text class="card-t">打卡热力</text>
        <text class="card-s">近 98 天</text>
      </view>
      <view class="heat">
        <view wx:for="{{heatCells}}" wx:key="key" class="heat-cell lv{{item.level}}"></view>
      </view>
      <view class="heat-legend">
        <text>少</text>
        <view class="heat-cell lv0"></view>
        <view class="heat-cell lv1"></view>
        <view class="heat-cell lv2"></view>
        <view class="heat-cell lv3"></view>
        <text>多</text>
      </view>
    </view>
  </block>
</view>

<toast id="toast" />
