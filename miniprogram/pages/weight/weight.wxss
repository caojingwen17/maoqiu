/* 体重表单页 */
.pet-head {
  display: flex;
  align-items: center;
  gap: 22rpx;
}
.pet-head .avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
}
.grow { flex: 1; min-width: 0; }
.big-input {
  text-align: center;
  padding: 57rpx 35rpx 44rpx;
}
.big-num {
  font-size: 92rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  letter-spacing: -2rpx;
}
.big-unit {
  font-size: 35rpx;
  font-weight: 500;
  color: var(--t3);
}
.big-hint {
  font-size: 24rpx;
  color: var(--t2);
  margin-top: 13rpx;
}
.prev-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
}
.foot {
  flex: none;
  padding: 13rpx 35rpx 57rpx;
}
.save-more {
  text-align: center;
  font-size: 29rpx;
  color: var(--pop-deep);
  font-weight: 600;
  padding: 22rpx 0 4rpx;
}
/* 键盘遮罩：点击键盘外区域收起 */
.pad-mask {
  position: fixed;
  inset: 0;
  z-index: 19;
}

/* 宠物头像图（填充 pet-head 圆形头像位） */
.pet-head .avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}
